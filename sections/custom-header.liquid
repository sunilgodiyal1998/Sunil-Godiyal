{% stylesheet %}
.custom-header-bar {
  width: 100%;
  background: {{ section.settings.bg_color }};
}

.custom-header-inner {
    max-width: 3840px;
    margin: 0 auto;
    padding: 0px 370px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    background: #f5f5f5;
    height: 170.67px;
}

/* LOGO */
.custom-header-logo img {
  max-height: 60px;
}

.custom-header-logo span {
  font-family: Jost;
  font-size: 42px;
  font-weight: 600;
}

/* CENTER TEXT */
.custom-header-text {
    font-family: Jost;
    font-weight: 400;
    font-size: 42.67px;
    line-height: 35.8px;
    text-align: center;
    color: #000;
}

/* BUTTON */
a.custom-header-btn {
    background: #FFF544;
    color: black;
    font-family: Jost;
    font-size: 42.67px;
    line-height: 54.61px;
    text-transform: uppercase;
    padding: 33.56px 140.64px 33.56px 129.64px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    z-index: 1;
}

/* overlay */
a.custom-header-btn::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 100%;
    background: black;
    transition: width 0.4s ease;
    z-index: -1;
}

/* hover */
a.custom-header-btn:hover::after {
    width: 100%;
}

a.custom-header-btn:hover {
    color: white;
    z-index: 1;
}

/* arrow */
a.custom-header-btn::before {
    content: '';
    position: absolute;
    right: 40px;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    height: 27px;
    background: url('/cdn/shop/files/Line_15.png?v=1777315171') no-repeat center;
    background-size: contain;
    z-index: 2;
}

/* HIDE MOBILE ICON ON DESKTOP */
.mobile-menu-toggle {
  display: none;
}

/* ================= MOBILE ================= */
@media (max-width: 768px) {

  .custom-header-inner {
    display: grid !important;
    grid-template-columns: auto 1fr auto !important;
    align-items: center;
    padding: 0 20px;
    height: 65px;
    position: relative;
  }

  .mobile-menu-toggle {
    display: block !important;
    font-size: 18px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 5;
  }

  .custom-header-logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    top: 34%;
  }

  .custom-header-logo img {
    max-height: 20px;
    width: 151.44px;
    height: 19px;
  }

  .custom-header-logo span {
    font-size: 26px;
  }

  .custom-header-text,
  .custom-header-btn {
    display: none !important;
  }
}

/* ================= 769–1279 ================= */
@media (min-width: 769px) and (max-width: 1279px) {

  .custom-header-inner {
    padding: 0 40px;
    height: 90px;
  }

  .custom-header-logo img {
    max-height: 40px;
  }

  .custom-header-logo span {
    font-size: 22px;
  }

  .custom-header-text {
    font-size: 20px;
    line-height: 24px;
  }

  a.custom-header-btn {
    font-size: 16px;
    padding: 12px 40px;
  }

  a.custom-header-btn::before {
    width: 28px;
    height: 12px;
    right: 15px;
  }
}

/* ================= 1280–1920 (CLEAN MERGED) ================= */
@media (min-width: 1280px) and (max-width: 1920px) {

  .custom-header-inner {
    /* max-width: 1440px; */
    padding: 0 80px;
    height: 110px;
  }

  .custom-header-logo img {
    max-height: 45px;
  }

  .custom-header-logo span {
    font-size: 28px;
  }

  .custom-header-text {
    font-size: 28px;
    line-height: 30px;
  }

  a.custom-header-btn {
    font-size: 20px;
    padding: 16px 60px;
  }

  a.custom-header-btn::before {
    width: 40px;
    height: 18px;
    right: 20px;
  }
}

/* ================= 1921–2850 ================= */
@media (min-width: 1921px) and (max-width: 2850px) {

  .custom-header-inner {
    /* max-width: 2200px; */
    padding: 0 200px;
    height: 200px;
  }

  .custom-header-logo img {
    max-height: 70px;
  }

  .custom-header-logo span {
    font-size: 50px;
  }

  .custom-header-text {
    font-size: 50px;
    line-height: 55px;
  }

  a.custom-header-btn {
    font-size: 48px;
    padding: 40px 160px;
  }

  a.custom-header-btn::before {
    width: 80px;
    height: 34px;
    right: 40px;
  }
}

{% endstylesheet %}


<div class="custom-header-bar">
  <div class="custom-header-inner">

    <!-- MOBILE MENU BUTTON -->
    <button class="mobile-menu-toggle" onclick="toggleMenu()">☰</button>

    <!-- LOGO -->
    <div class="custom-header-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
        {% else %}
          <span>{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- CENTER TEXT -->
    <div class="custom-header-text">
      {{ section.settings.center_text }}
    </div>

    <!-- BUTTON -->
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="custom-header-btn">
        {{ section.settings.btn_text }}
      </a>
    {% endif %}

  </div>
</div>

<!-- MOBILE DRAWER -->
<div id="mobileDrawer" class="mobile-drawer">
  <div class="drawer-content">
    <button class="close-btn" onclick="toggleMenu()">✕</button>

    <ul class="mobile-menu">
      {% for link in linklists.main-menu.links %}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

<script>
function toggleMenu() {
  document.getElementById("mobileDrawer").classList.toggle("active");
}
</script>


{% schema %}
{
  "name": "Custom Header 4K",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#f4e600"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom Header 4K"
    }
  ]
}
{% endschema %}