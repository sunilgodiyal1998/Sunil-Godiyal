{% stylesheet %}

/* ===== HIDE MOBILE LAYOUT BY DEFAULT ===== */
.gift-mobile-only {
  display: none;
}

/* ===== SECTION 1 (IMAGE) ===== */
.gift-hero {
    width: 100%;
    height: 1065px;
    background-size: cover;
    background-position: left;
    background-repeat: no-repeat;
    position: relative;
}

/* BUTTON OVER IMAGE */
.gift-hero__btn-wrap {
  display: none;
}

/* ===== SECTION 2 ===== */
.gift-banner {
  position: relative;
  width: 100%;
  background: #fff;
}

.gift-banner__inner {
    margin: 0 auto;
    padding: 0px 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 370px;
}

.gift-banner__content {
  width: 50%;
}

.gift-banner__title {
    font-family: Jost;
    font-size: 164.78px;
    font-weight: 500;
    margin-bottom: 100px;
    color: #000;
}

.gift-banner__text {
    font-family: Jost;
    font-size: 47.08px;
    margin-bottom: 118px;
    color: #444;
}
a.gift-banner__btn:hover {
    padding: 35px 110px 31px 55px;
}
.gift-banner__btn {
    background: #000;
    color: #ffffff;
    font-family: Jost;
    font-size: 42.67px;
    line-height: 0;
    text-transform: uppercase;
    padding: 33.56px 185.64px 33.56px 129.64px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    z-index: 1;
}

/* ARROW */
.gift-banner__btn::before {
    content: '';
    position: absolute;
    right: 50px;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    height: 27px;
    background: url('/cdn/shop/files/Line_15_1.png?v=1777315830') no-repeat center;
    background-size: contain;
    z-index: 2;
}

/* HOVER OVERLAY */
.gift-banner__btn::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 100%;
    background: #FFF544;
    transition: width 0.4s ease;
    z-index: -1;
    color: #000 !important;
}

/* HOVER ACTION */
.gift-banner__btn:hover::after {
    width: 100%;
}

/* TEXT COLOR CHANGE */
.gift-banner__btn:hover {
    color: black;
    position: relative;
    z-index: 999;
    display: block;
    width: 64%;
}

/* IMAGE */
.gift-banner__image img {
    width: 100%;
    height: 1072px;
}

/* BOTTOM */
.gift-banner__bottom {
    text-align: center;
    padding: 15px;
    font-size: 42.67px;
    background: #f5f5f5;
}

/* ================= MOBILE ================= */
@media (max-width: 768px) {

  .gift-mobile-only {
    display: block;
  }

  .gift-hero,
  .gift-banner {
    display: none;
  }

  .gift-mobile-top {
    text-align: center;
    padding: 16px 8px;
  }

  .gift-mobile-title {
    font-size: 30px;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .gift-mobile-text {
    font-size: 16px;
    line-height: 130%;
    max-width: 340px;
    margin: 0 auto 16px;
    color:black;
    font-weight:400;
  }

  .gift-mobile-image {
    position: relative;
  }

  .gift-mobile-image img {
    width: 100%;
    height: 264px;
    display: block;
    object-fit: cover;
  }

  .gift-hero__btn-wrap {
    display: flex;
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
  }

  .gift-mobile-btn {
    background: #000;
    color: #fff;
    padding: 14px 19px;
    font-size: 16px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    font-weight: 400;
    line-height: 20.48px;
  }

  .gift-mobile-btn::after {
    content: "";
    width: 30px;
    height: 12px;
    margin-left: 12px;
    background-image: url("/cdn/shop/files/Line_15_1.png?v=1777315830");
    background-size: contain;
    background-repeat: no-repeat;
  }

  .gift-mobile-bottom {
    text-align: center;
    padding: 15px;
    font-size: 14px;
    font-weight: 400;
    background: #f5f5f5;
    line-height: 13.46px;
    color: black !important;
  }
}

/* ================= 769–1279 ================= */
@media (min-width: 769px) and (max-width: 1279px) {

  .gift-hero { height: 600px; }

  .gift-banner__inner {
    padding-left: 40px;
    padding-right: 20px;
  }

  .gift-banner__content { width: 55%; }

 .gift-banner__title {
    font-size: 45px;
    margin-bottom: 30px;
    margin-top: 0px;
}

  .gift-banner__text {
    font-size: 16px;
    margin-bottom: 30px;
  }

  .gift-banner__btn {
    font-size: 16px;
    padding: 14px 60px 14px 30px;
  }

  .gift-banner__btn::before {
    width: 28px;
    height: 12px;
    right: 20px;
  }

  .gift-banner__image img { height: 500px; }

  .gift-banner__bottom {
    font-size: 16px;
    padding: 10px;
  }
}

/* ================= 1280–1920 (MERGED CLEAN) ================= */
@media (min-width: 1280px) and (max-width: 1920px) {

  .gift-hero { height: 700px; }

  .gift-banner__inner {
    padding-left: 100px;
    padding-right: 50px;
  }

  .gift-banner__content { width: 52%; }

  .gift-banner__title {
    font-size: 55px;
    margin-bottom: 30px;
    margin-top: 0px;
}

  .gift-banner__text {
    font-size: 20px;
    margin-bottom: 55px;
  }

  .gift-banner__btn {
    font-size: 20px;
    padding: 18px 110px 18px 55px;
  }

  .gift-banner__btn::before {
    width: 38px;
    height: 15px;
    right: 28px;
  }

  .gift-banner__image img { height: 700px; }

  .gift-banner__bottom {
    font-size: 20px;
    padding: 12px;
  }
}

/* ================= 1921–2850 ================= */
@media (min-width: 1921px) and (max-width: 2850px) {

  .gift-hero { 
    height: 1000px; 
  }

  .gift-banner__inner {
    padding-left: 220px;   
    padding-right: 80px;
  }

  .gift-banner__content {
    width: 50%;
  }

.gift-banner__title {
    font-size: 80px;
    margin-bottom: 80px;
    margin-top: 0px;
}

  .gift-banner__text {
    font-size: 30px;       
    margin-bottom: 90px;
  }

  .gift-banner__btn {
    font-size: 30px;
    padding: 30px 160px 30px 100px;
  }

  .gift-banner__btn::before {
    width: 60px;
    height: 24px;
    right: 40px;
  }

  .gift-banner__image img { 
    height: 1000px;
  }

  .gift-banner__bottom {
    font-size: 34px;
    padding: 18px;
  }

}

{% endstylesheet %}


<!-- ================= MOBILE LAYOUT ================= -->
<div class="gift-mobile-only">

  <!-- TEXT -->
  <div class="gift-mobile-top">
    <h2 class="gift-mobile-title">{{ section.settings.heading }}</h2>
    <p class="gift-mobile-text">{{ section.settings.text }}</p>
  </div>

  <!-- IMAGE WITH BUTTON -->
  <div class="gift-mobile-image">
    {% if section.settings.top_image != blank %}
              <img src="{{ section.settings.image | image_url: width: 1500 }}" alt="">
    {% endif %}

    <div class="gift-hero__btn-wrap">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="gift-mobile-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <!-- BOTTOM -->
  <div class="gift-mobile-bottom">
    {{ section.settings.bottom_text }}
  </div>

</div>


<!-- ================= DESKTOP (UNCHANGED) ================= -->
<div class="gift-hero"
  style="background-image: url({{ section.settings.top_image | image_url: width: 3840 }});">
</div>

<div class="gift-banner">

  <div class="gift-banner__inner">

    <div class="gift-banner__content">
      <h2 class="gift-banner__title">{{ section.settings.heading }}</h2>
      <p class="gift-banner__text">{{ section.settings.text }}</p>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="gift-banner__btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <div class="gift-banner__image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1500 }}" alt="">
      {% endif %}
    </div>

  </div>

  <div class="gift-banner__bottom">
    {{ section.settings.bottom_text }}
  </div>

</div>

{% schema %}
{
  "name": "Gift Guide Banner 4K",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner 4K"
    }
  ]
}
{% endschema %}

