<h2 class="mobile-grid-heading">Tisso vison in the wild</h2>
<div class="grid-wrapper">
{% for block in section.blocks %}
  {% assign product = block.settings.product %}
  {% if product %}
    <div class="grid-item"
      data-title="{{ product.title }}"
      data-img="{{ product.featured_image | image_url }}"
      data-price="{{ product.price | money }}"
      data-desc="{{ product.description | strip_html | truncate: 120 }}"
      data-variants='{{ product.variants | json }}'>

      <img src="{{ product.featured_image | image_url }}">
<div class="plus-icon"
     style="top: {{ block.settings.icon_top }}%; left: {{ block.settings.icon_left }}%; transform: translate(-50%, -50%);">
  +
</div>
    </div>
  {% endif %}
{% endfor %}
</div>

<!-- POPUP -->
<div class="popup" id="popup">
  <div class="popup-content">

    <span class="close-popup">&times;</span>

    <div class="popup-grid">

      <!-- ROW 1 -->
      <div class="popup-left">
        <img id="popup-img">
      </div>

      <div class="popup-right">
        <h3 id="popup-title"></h3>
        <p id="popup-price"></p>
        <div id="popup-desc"></div>
      </div>

      <!-- ROW 2 (FULL WIDTH) -->
      <div class="popup-bottom">
        <div id="product-options"></div>

        <button id="add-to-cart-btn" class="add-to-cart-btn">
          ADD TO CART 
        </button>
      </div>

    </div>

  </div>
</div>

<script>
let selectedVariantId = null;
let variantsData = [];
let colorIndex = 1;
let sizeIndex = 2;

// OPEN POPUP
document.querySelectorAll('.grid-item').forEach(item => {
  item.onclick = function() {
    document.getElementById('popup').style.display = 'flex';

    document.getElementById('popup-img').src = this.dataset.img;
    document.getElementById('popup-title').innerText = this.dataset.title;
    document.getElementById('popup-desc').innerText = this.dataset.desc;

    variantsData = JSON.parse(this.dataset.variants);

    detectOptions();
    renderOptions();
  };
});

// 🔥 DETECT COLOR & SIZE INDEX
function detectOptions() {
  const optionKeys = ['option1','option2','option3'];

  colorIndex = null;
  sizeIndex = null;

  optionKeys.forEach((key, i) => {
    let values = variantsData.map(v => (v[key] || '').toLowerCase());

    if (values.some(v => ['black','white','red','blue','green','yellow','pink','grey','brown'].some(c => v.includes(c)))) {
      colorIndex = i + 1;
    }

    if (values.some(v => ['xs','s','m','l','xl','xxl','small','medium','large'].includes(v))) {
      sizeIndex = i + 1;
    }
  });

  if (!colorIndex) colorIndex = 1;
  if (!sizeIndex) sizeIndex = 2;
}

// 🎨 RENDER OPTIONS
function renderOptions() {
  const container = document.getElementById('product-options');
  container.innerHTML = '';

  if (!variantsData.length) return;

  // 👉 COLORS
  let colors = [...new Set(variantsData.map(v => v['option'+colorIndex]).filter(Boolean))];

  if (colors.length) {
    let wrap = document.createElement('div');
    wrap.classList.add('option-group');
    wrap.innerHTML = `<p>Color</p>`;

    let btnWrap = document.createElement('div');
    btnWrap.classList.add('color-buttons');

    colors.forEach((color, index) => {
      let btn = document.createElement('button');
      btn.innerText = color;
      btn.dataset.value = color;

      // 🎨 COLOR MAP
      let colorMap = {
        black: '#000',
        white: '#ddd',
        red: 'red',
        blue: 'blue',
        green: 'green',
        yellow: 'gold',
        pink: 'pink',
        grey: 'grey',
        gray: 'grey',
        brown: 'brown'
      };

      let clr = color.toLowerCase();

      // APPLY LEFT BORDER COLOR
      btn.style.borderLeft = `5px solid ${colorMap[clr] || clr}`;

      // AUTO SELECT FIRST
      if (index === 0) btn.classList.add('active');

      btn.onclick = function() {
        document.querySelectorAll('.color-buttons button').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        updateVariant();
      };

      btnWrap.appendChild(btn);
    });

    wrap.appendChild(btnWrap);
    container.appendChild(wrap);
  }

  // 👉 SIZE DROPDOWN
  let sizes = [...new Set(variantsData.map(v => v['option'+sizeIndex]).filter(Boolean))];

  {% comment %} if (sizes.length) {
    let wrap = document.createElement('div');
    wrap.classList.add('option-group');
    wrap.innerHTML = `<p>Size</p>`;

    let select = document.createElement('select');
    select.innerHTML = `<option value="">Choose your size</option>`;

    sizes.forEach(size => {
      let opt = document.createElement('option');
      opt.value = size;
      opt.text = size;
      select.appendChild(opt);
    });

    select.onchange = updateVariant;

    wrap.appendChild(select);
    container.appendChild(wrap);
  } {% endcomment %}
 if (sizes.length) {
  let wrap = document.createElement('div');
  wrap.classList.add('option-group');
  wrap.innerHTML = `<p>Size</p>`;

  let dropdown = document.createElement('div');
  dropdown.classList.add('custom-select');

  let selected = document.createElement('div');
  selected.classList.add('select-selected');
  selected.innerText = 'Choose your size';

  let list = document.createElement('div');
  list.classList.add('select-items');

  sizes.forEach(size => {
    let item = document.createElement('div');
    item.innerText = size;

    item.onclick = function () {
      selected.innerText = size;

      // trigger your existing function
      updateVariant({ target: { value: size } });

      list.classList.remove('open');
    };

    list.appendChild(item);
  });

  selected.onclick = function () {
    list.classList.toggle('open');
  };

  dropdown.appendChild(selected);
  dropdown.appendChild(list);
  wrap.appendChild(dropdown);
  container.appendChild(wrap);
}
  updateVariant();
}

// 🔄 UPDATE VARIANT
function updateVariant() {
  let selectedColor = document.querySelector('.color-buttons .active')?.dataset.value;
  let selectedSize = document.querySelector('#product-options select')?.value;

  let matched = variantsData.find(v => {
    return (!selectedColor || v['option'+colorIndex] === selectedColor) &&
           (!selectedSize || v['option'+sizeIndex] === selectedSize);
  });

  if (matched) {
    selectedVariantId = matched.id;
    document.getElementById('popup-price').innerText =
      '₹' + (matched.price / 100).toFixed(2);
  }
}

// ❌ CLOSE POPUP
document.querySelector('.close-popup').onclick = () => {
  document.getElementById('popup').style.display = 'none';
};

window.onclick = (e) => {
  if (e.target.id === 'popup') {
    document.getElementById('popup').style.display = 'none';
  }
};

// 🛒 ADD TO CART
document.getElementById('add-to-cart-btn').onclick = function() {
  if (!selectedVariantId) {
    alert('Please select options');
    return;
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      items: [
        {
          id: selectedVariantId,
          quantity: 1
        }
      ]
    })
  })
  .then(() => {
    window.location.href = '/cart';
  })
  .catch(err => console.error(err));
};
</script>