{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Product Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
  "type": "range",
  "id": "icon_top",
  "label": "Icon Top Position (%)",
  "min": 0,
  "max": 100,
  "step": 1,
  "default": 50
},
{
  "type": "range",
  "id": "icon_left",
  "label": "Icon Left Position (%)",
  "min": 0,
  "max": 100,
  "step": 1,
  "default": 50
},
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}

<style>
.grid-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    padding: 250px 0px 200px 0;
    max-width: 2800px;
    margin: auto;
}

.grid-item {
  position: relative;
  cursor: pointer;
}

.grid-item img {
    width: 919.7779541015625px;
    transition: 0.4s;
    height: 943.1441040039062px;
    object-fit: cover;
}
.grid-item:hover img {
  transform: scale(1.05);
}

.plus-icon {
    position: absolute;
    background: #fff;
    width: 57px;
    height: 57px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 41px;
}

/* POPUP */
.popup {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.popup-content {
    background: #fff;
    max-width: 960px;
    width: 90%;
    padding: 25px;
    position: relative;
}
.popup-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

/* FULL WIDTH SECOND ROW */
.popup-bottom {
  grid-column: 1 / -1;
  margin-top: 10px;
}

/* spacing */
.popup-right {
    padding-right: 10px;
    padding-top: 58px;
}

h3#popup-title {
    font-size: 42px;
    margin-bottom: 45px;
}
.popup-left {
    padding-top: 60px;
}

.popup-left img {
    width: 100%;
    height: 505px;
    object-fit: cover;
}
.close-popup {
    position: absolute;
    top: 3px;
    right: 30px;
    font-size: 54px;
    cursor: pointer;
}

#popup-price {
    font-weight: 500;
    margin: 10px 0;
    font-size: 44px;
    font-family: 'Jost';
}

#popup-desc {
    font-size: 35px;
    margin-bottom: 0;
    color: #000;
    font-weight: 300;
    font-family: 'Jost';
    line-height: 46px;
    position: relative;
    top: 34px;
}

/* OPTIONS */
.option-group {
  margin-bottom: 15px;
}

.option-group p {
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 35px;
}

/* COLOR BUTTONS */
.color-buttons {
  display: flex;
  border: 1px solid #ccc;
}

.color-buttons button {
    flex: 1;
    padding: 12px;
    border: none;
    background: #f5f5f5;
    cursor: pointer;
    border-right: 1px solid #ccc;
    border-left: 5px solid transparent;
    text-align: left;
    padding-left: 35px;
    font-size: 30px;
}

.color-buttons button:last-child {
  border-right: none;
}

.color-buttons button.active {
  background: #000;
  color: #fff;
}

/* SIZE DROPDOWN */
#product-options select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    font-size: 38px;
    font-weight: 300 !IMPORTANT;
    color: #000;
    font-family: 'Jost';
}

/* BUTTON */
.add-to-cart-btn {
    width: 100%;
    padding: 26px;
    background: #000;
    color: #fff;
    border: none;
    margin-top: 100px;
    cursor: pointer;
    font-size: 30px;
    Position: relative;
    margin-bottom: 35px;
}
.add-to-cart-btn::after {
    content: "";
    display: inline-block;
    width: 64px;
    height: 27px;
    margin-left: 60px;
    background-image: url("/cdn/shop/files/Line_15_1.png?v=1777315830");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
